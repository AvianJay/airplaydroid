<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Socket access. At targetSdk <= 36 this is also what implicitly grants
         local network access; ACCESS_LOCAL_NETWORK must NOT be declared until
         targetSdk 37, where it becomes mandatory. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Required by the NsdManager.discoverServices(type, protocol, NetworkRequest,
         Executor, listener) overload used on API 33+. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Screen mirroring: the capture itself is gated by the per-session consent
         prompt, which is what satisfies this type's runtime prerequisite. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- Screen-mirroring audio: AudioPlaybackCapture (API 29+) needs it even
         though it records what apps play, not the microphone. Requested in
         context; a denial only means mirroring without sound. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Only the mirroring notification (and its Stop action) uses it. Requested on
         first launch; a denial hides that notification but never blocks discovery
         or mirroring. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Declared required=false so the Play Console does not implicitly filter the
         app to Wi-Fi-capable devices only. -->
    <uses-feature
        android:name="android.hardware.wifi"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AirPlayDroid"
        android:networkSecurityConfig="@xml/network_security_config">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:theme="@style/Theme.AirPlayDroid">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Screen mirroring. A MediaProjection can only be obtained from a service
             already in the foreground as mediaProjection, entered after capture
             consent. Discovery has no service: it runs only while the picker is
             on screen. -->
        <service
            android:name=".service.MirrorService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

    </application>

</manifest>
