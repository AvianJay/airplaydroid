<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Socket access. At targetSdk <= 36 this is also what implicitly grants
         local network access; ACCESS_LOCAL_NETWORK must NOT be declared until
         targetSdk 37, where it becomes mandatory. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Required by the NsdManager.discoverServices(type, protocol, NetworkRequest,
         Executor, listener) overload used on API 33+. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Screen mirroring: the capture itself is gated by the per-session consent
         prompt, which is what satisfies this type's runtime prerequisite. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- Screen-mirroring audio: AudioPlaybackCapture (API 29+) needs it even
         though it records what apps play, not the microphone. Requested in
         context; a denial only means mirroring without sound. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Only the mirroring notification (and its Stop action) uses it. Requested on
         first launch; a denial hides that notification but never blocks discovery
         or mirroring. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- The in-app updater. Needed to hand a downloaded APK to the system
         installer; the app never installs anything itself. From Android 8 this is
         a per-app "install unknown apps" grant the user gives in Settings, not a
         runtime dialog, so the updater checks it and links there when it is
         missing rather than failing silently. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Declared required=false so the Play Console does not implicitly filter the
         app to Wi-Fi-capable devices only. -->
    <uses-feature
        android:name="android.hardware.wifi"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AirPlayDroid"
        android:networkSecurityConfig="@xml/network_security_config">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:theme="@style/Theme.AirPlayDroid">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The casting popup, opened from the Quick Settings tile. Not exported:
             only this app's tile starts it, and it needs no other entry point.
             excludeFromRecents keeps it out of the app switcher, so closing it
             returns to whatever was underneath rather than to a recents entry.
             The translucent theme is what makes it read as a dialog over the
             current screen instead of a screen of its own. -->
        <activity
            android:name=".CastPopupActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:theme="@style/Theme.AirPlayDroid.Popup" />

        <!-- The Quick Settings tile. Exported, and it must be: the SystemUI
             process binds it to render the tile, and android:icon is what the
             user sees when picking a tile to add. -->
        <service
            android:name=".CastTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_cast"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Screen mirroring. A MediaProjection can only be obtained from a service
             already in the foreground as mediaProjection, entered after capture
             consent. Discovery has no service: it runs only while the picker is
             on screen. -->
        <service
            android:name=".service.MirrorService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- Serves the downloaded APK to the system installer. A file:// URI
             would throw FileUriExposedException, and the installer cannot read
             this app's cache directory directly, so the download is exposed
             through this provider with a read-only grant on the intent.
             Not exported and not grantable by default: the only grant is the
             one ApkInstaller attaches to its own intent. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
